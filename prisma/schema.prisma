// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique // IMPORTANT: Make this unique!
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("email_verification") // Add default value
  expiresAt DateTime
  usedAt    DateTime? // IMPORTANT: Make this optional (nullable)
  createdAt DateTime  @default(now())

  @@index([userId]) // Index for user queries
  @@index([expiresAt]) // Index for cleanup queries
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  password   String
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Add this for tracking updates

  books              Books[]
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]
  reviews            Reviews[]
}

model Books {
  id            String    @id @default(cuid())
  title         String
  author        String
  overview      String?
  publishedYear Int
  imageUrl      String?
  addedBy       User      @relation(fields: [addedById], references: [id], onDelete: Cascade) // Add onDelete
  addedById     String
  createdAt     DateTime  @default(now())
  reviews       Reviews[]
  reviewCount   Int       @default(0)
  avgRating     Float     @default(0)

  @@index([addedById]) // Add index for better query performance
  @@index([publishedYear]) // Add index for better query performance
  @@index([avgRating]) // Add index for better query performance
}

model Reviews {
  id          String   @id @default(cuid())
  book        Books    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId      String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  star        Int
  comment     String   @db.Text
  createdOn   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  edited      Boolean  @default(false)

  @@unique([bookId, createdById]) // ✅ Added - one review per user per book
  @@index([bookId]) // ✅ Added - fast lookup of all reviews for a book
  @@index([createdById]) // ✅ Added - fast lookup of all reviews by a user
}
